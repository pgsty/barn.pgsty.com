: "${BARN_CAST_ROOT:?Set BARN_CAST_ROOT to the prepared recording directory}"
export PS1='\[\e[1;32m\]macOS\[\e[0m\] \[\e[1;34m\]\W\[\e[0m\] $ '
export BARN_HOME="$BARN_CAST_ROOT/barn-home"
export BARN_REPO="${BARN_CAST_REPO:-https://repo.pigsty.cc/barn}"
export HOMEBREW_CACHE="$BARN_CAST_ROOT/brew-cache"
export HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_INSTALL_CLEANUP=1 HOMEBREW_NO_ENV_HINTS=1
# macOS Expect can misdecode four-byte emoji; keep future takes plain text.
export HOMEBREW_NO_EMOJI=1
if [ -n "${BARN_CAST_PROXY:-}" ]; then
  export http_proxy="$BARN_CAST_PROXY" https_proxy="$BARN_CAST_PROXY"
  export HTTP_PROXY="$BARN_CAST_PROXY" HTTPS_PROXY="$BARN_CAST_PROXY"
  export no_proxy=localhost,127.0.0.1,.pigsty.cc,10.10.10.10,10.10.10.11,10.10.10.12,10.10.10.13
  export NO_PROXY="$no_proxy"
fi
export TERM=xterm-256color
export HISTFILE=/dev/null
PROMPT_COMMAND='printf "%s\n" "$?" > "$BARN_CAST_ROOT/command-status"'
cd "$BARN_CAST_ROOT/session" || exit 1
stty cols 80 rows 24
clear
