#!/usr/bin/expect -f
# Drive a real macOS Homebrew/Pigsty session for the home-page recording.
# Typing is simulated; every command and its output are real.
set timeout 60
set send_human {.04 .07 1 .02 .16}
log_user 1
set host_prompt {\x1b\[0m \$ $}

if {![info exists env(BARN_CAST_ROOT)]} {
  puts stderr "BARN_CAST_ROOT must name the prepared recording directory"
  exit 2
}
set rc [file join [file dirname [file normalize [info script]]] demo.rc]
set env(BASH_SILENCE_DEPRECATION_WARNING) 1

proc check_status {text} {
  global env
  set handle [open [file join $env(BARN_CAST_ROOT) command-status] r]
  set status [string trim [read $handle]]
  close $handle
  if {$status ne "0"} {
    puts stderr "\n!! command failed ($status): $text"
    exit 3
  }
}

proc type_line {text} {
  send -h -- $text
  sleep 0.45
  send -- "\r"
}

proc run {text wait} {
  global host_prompt timeout
  type_line $text
  set timeout $wait
  expect {
    -re $host_prompt {}
    eof { puts stderr "\n!! shell exited after: $text"; exit 3 }
    timeout { send_user "\n!! timeout after: $text\n"; exit 3 }
  }
  check_status $text
  sleep 1.3
}

spawn -noecho /bin/bash --noprofile --rcfile $rc -i
expect -re $host_prompt
sleep 1.5

run {brew install pgsty/infra/barn} 600
run {cd pigsty} 20
run {./configure -c full} 60

type_line {barn up}
set timeout 1500
expect {
  -ex {[Y/n]} {
    sleep 1.6
    send -h -- "y"
    sleep 0.3
    send -- "\r"
    exp_continue
  }
  -ex {Password:} { send_user "\n!! unexpected sudo prompt\n"; exit 3 }
  -re $host_prompt {}
  eof { puts stderr "\n!! shell exited during barn up"; exit 3 }
  timeout { send_user "\n!! barn up timeout\n"; exit 3 }
}
check_status {barn up}
sleep 2

run {barn status} 60
sleep 4
# End on the ready table, with no extra exit command in the demo.
send -- "\004"
expect eof
