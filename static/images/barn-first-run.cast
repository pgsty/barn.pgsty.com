[11.868, "o", "[\u001b[0;33mWARN\u001b[0m] \u001b[0;33mprimary_ip = default placeholder 10.10.10.10 (macOS)\u001b[0m\r\r\n"]
[11.8681, "o", "[\u001b[0;32m OK \u001b[0m] \u001b[0;32mmode = full (manually set)\u001b[0m\r\r\n"]
