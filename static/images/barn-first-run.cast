[11.9237, "o", "[\u001b[0;32m OK \u001b[0m] \u001b[0;32mansible = ready\u001b[0m\r\r\n[\u001b[0;32m OK \u001b[0m] \u001b[0;32mpigsty configured\u001b[0m\r\r\n[\u001b[0;33mWARN\u001b[0m] \u001b[0;33mdon't forget to check it and change passwords!\u001b[0m\r\r\n\u001b[0;34mproceed with ./deploy.yml\r\r\n\u001b[0m"]
